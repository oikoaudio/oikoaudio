+    /// Record the window's current size. `size.scale_factor` includes the user zoom, and the
+    /// stored size keeps the unit of the size the state was created with.
+    pub(crate) fn store_window_size(&self, size: WindowSize) {
+        self.system_scale_factor
+            .store(Some(size.scale_factor as f32));
+
+        let new_size = match self.size.load() {
+            Size::Logical(_) => Size::Logical(size.logical),
+            Size::Physical(_) => Size::Physical(size.physical),
+        };
+        self.size.store(new_size);
