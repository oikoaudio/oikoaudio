+            let mut info = std::mem::zeroed();
+            assert!(ports.get.unwrap()(host.plugin, 0, true, &mut info));
+            assert_eq!(
+                info.supported_dialects & CLAP_NOTE_DIALECT_MIDI_MPE != 0,
+                enabled
+            );
+            assert_eq!(info.preferred_dialect, CLAP_NOTE_DIALECT_CLAP);
+        }
+    }
+}
