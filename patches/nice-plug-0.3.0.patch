+fn clap_advertises_mpe_only_when_opted_in() {
+    use clap_sys::ext::note_ports::*;
+    for enabled in [false, true] {
+        let host = Host::new(enabled);
+        unsafe {
+            let ports =
+                &*((*host.plugin).get_extension.unwrap()(host.plugin, CLAP_EXT_NOTE_PORTS.as_ptr())
